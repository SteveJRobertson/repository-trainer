# Copy to .env.local and fill in. .env.local is git-ignored.

# Required for generating lessons: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: raises GitHub's API limit from 60 to 5,000 requests an hour.
# A fine-grained token with no extra permissions is enough for public repos.
GITHUB_TOKEN=

# Optional: override the model (defaults to claude-opus-5-5).
# TRAINER_MODEL=
