# Copy to .env.local and fill in. .env.local is git-ignored.

# Add a key for at least one AI provider. You pick between the ones set up on
# the home screen.
# Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ChatGPT: https://platform.openai.com/api-keys (a ChatGPT subscription alone is not enough)
OPENAI_API_KEY=
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ollama runs open models on this machine, free and with no key. Install it
# from https://ollama.com, pull a model ("ollama pull <model>"), and name it
# here to turn it on. Pick a coding model with a long context window.
# OLLAMA_MODEL=
# Optional: where Ollama runs, and its context window in tokens. Lessons send
# up to about 70k tokens; lower this only if the model can't fit it.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_NUM_CTX=131072

# Optional: override each provider's model.
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-5.5
# GEMINI_MODEL=gemini-3.6-flash

# Optional: send ChatGPT requests through a company gateway or other
# OpenAI-compatible endpoint.
# OPENAI_BASE_URL=

# Optional: raises GitHub's API limit from 60 to 5,000 requests an hour.
# A fine-grained token with no extra permissions is enough for public repos.
GITHUB_TOKEN=
